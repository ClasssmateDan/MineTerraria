Mods: {
	DimensionalTerraria: {
		Configs: {
			DimensionConfig: {
				DisplayName: MineTerraria 设置

				EnableExplorationFog: {
					Label: 启用三维探索迷雾
					Tooltip: 只显示已探索的地图区域，并禁止返回未探索位置。
				}

				ShowCreatures: {
					Label: 显示三维生物精灵
					Tooltip: 在三维模式下显示生物。
				}

				Enable3DMining: {
					Label: 启用三维挖掘
					Tooltip: 允许在三维模式下挖掘和采集。
				}

				Enable3DCombat: {
					Label: 启用三维武器攻击
					Tooltip: 允许在三维模式下使用武器攻击。
				}

				Enable3DPlacement: {
					Label: 启用三维放置
					Tooltip: 允许在三维模式下放置方块和家具。
				}

				Enable3DPickup: {
					Label: 启用三维拾取
					Tooltip: 允许在三维模式下自动拾取附近掉落物。
				}

				PickupRadius: {
					Label: 三维拾取半径
					Tooltip: 三维自动拾取的距离，以方块格数计算；默认6格，可调2至12格。以飞行身体计算真实距离，包含离开地图的纵深。
				}

				EntryDistance: {
					Label: 进入三维的距离
					Tooltip: 进入三维后与二维地图的距离，以方块格数计算；默认32格。
				}

				EnemyNoticeRange: {
					Label: 敌怪重新发现距离
					Tooltip: 敌怪发现玩家的距离，单位为格。
				}

				EnemyLoseRange: {
					Label: 敌怪脱战距离
					Tooltip: 敌怪超过此距离会丢失目标，单位为格。
				}

				MouseSensitivity: {
					Label: 鼠标灵敏度
					Tooltip: 拖动滑条调整三维镜头转速，每像素鼠标移动对应的角度；默认0.06，可调0.01至0.30。值越小转向越慢；已保存的自定义值会保留。
				}

				FieldOfView: {
					Label: 第一人称视野角度
					Tooltip: 调整三维相机的垂直视野。
				}

				RenderDistance: {
					Label: 三维视距
					Tooltip: 以24格区块为单位；增加视距会使用更多内存。
				}

				FlightSpeed: {
					Label: 飞行速度
					Tooltip: 三维飞行的基础速度；Ctrl加速。
				}

				SmoothEdges: {
					Label: 边缘抗锯齿
					Tooltip: 使用4倍多重采样平滑几何边缘，保留原版像素贴图。
				}

				ShowLandingOutline: {
					Label: 显示返回位置轮廓
					Tooltip: 在世界平面上绘制绿色或红色的角色投影框。
				}

				EnableSwitching: {
					Label: 启用维度切换
					Tooltip: 允许在单人游戏中进入三维飞行。
				}

			}


			ItemCatalogConfig: {
				DisplayName: 物品图鉴

				Items: {
					Label: 本模组物品
					// Tooltip: ""
				}
			}

			VanillaItemCatalogConfig: {
				DisplayName: 原版物品图鉴

				Items: {
					Label: 全部原版物品
					Tooltip: 按中文名、英文内部名或物品ID搜索，点击图标立即领取。每页30件；仅单人世界内可领取。
				}
			}
		}

		Keybinds: {
			OpenBackpack.DisplayName: 打开三维背包
			ToggleDimension.DisplayName: 切换二维／三维
			ReturnToAnchor.DisplayName: 返回出发位置
		}

		Items: {
			NetheriteIngot: {
				DisplayName: 下界合金
				Tooltip: 用于制作高维投影装备
			}
			Firework: {
				DisplayName: 烟花
				Tooltip:
					'''
					向鼠标方向推进
					三维模式下按住右键，向准星方向推进
					'''
			}
			MinecraftChest: {
				DisplayName: Minecraft箱子
				Tooltip:
					'''
					右键打开箱子
					有物品时无法拆除
					'''
			}
			VillagerSpawnEgg: {
				DisplayName: 村民蛋
				Tooltip:
					'''
					在地面生成一名村民
					三维模式下对准地面按右键
					'''
			}
			Bedrock: {
				DisplayName: 基岩
				Tooltip: 只能在三维模式下用高维投影镐拆除
			}
			HigherDimensionalPickaxe: {
				DisplayName: 高维投影镐
				Tooltip: 三维模式下可以拆除基岩
			}
			HigherDimensionalHelmet: {
				DisplayName: 高维投影头盔
				Tooltip: 集齐全套获得被动防护
				SetBonus: 免疫岩浆、火块、跌落、击退和常见减益
			}
			HigherDimensionalChestplate: {
				DisplayName: 高维投影胸甲
				Tooltip: 集齐全套获得被动防护
			}
			HigherDimensionalLeggings: {
				DisplayName: 高维投影护腿
				Tooltip: 集齐全套获得被动防护
			}
			Hopper: {
				DisplayName: 漏斗
				Tooltip:
					'''
					收集正上方一格内的掉落物，送入下方的箱子
					不从上方箱子中取物品
					'''
			}
			Redstone: {
				DisplayName: 红石
				Tooltip: 红石合成材料
			}
			RedstoneBlock: {
				DisplayName: 红石块
				Tooltip: 为四个方向的相邻方块提供红石信号
			}
			RedstonePulser: {
				DisplayName: 红石脉冲器
				Tooltip:
					'''
					向四周输出红石脉冲，每半秒切换一次
					右键反转信号
					'''
			}
			Piston: {
				DisplayName: 活塞
				Tooltip:
					'''
					红石充能时伸出，最多推动12格方块
					收回时右键旋转方向
					'''
			}
			StickyPiston: {
				DisplayName: 粘性活塞
				Tooltip:
					'''
					收回时拉回前方一个方块
					收回时右键旋转方向
					'''
			}
			OakBoat: {
				DisplayName: 橡木船
				Tooltip:
					'''
					对地面或液面使用，三维模式下按右键
					困住经过的生物；船受到攻击时破坏
					承载的Boss受伤前会破船
					'''
			}
			OakPlanks: {
				DisplayName: 橡木板
				Tooltip: 建筑材料
			}
			MinecraftCraftingTable: {
				DisplayName: Minecraft工作台
				Tooltip: 靠近以制作Minecraft物品
			}
			PrefabIronGolem: {
				DisplayName: 预制铁傀儡
				Tooltip:
					'''
					在地面生成一只铁傀儡
					三维模式下对准地面按右键
					'''
			}
			CopperStorageBlock: {
				DisplayName: 铜块
				Tooltip: ""
			}

			TinStorageBlock: {
				DisplayName: 锡块
				Tooltip: ""
			}

			IronStorageBlock: {
				DisplayName: 铁块
				Tooltip: 4个铁块摆成T形，顶部放置南瓜可召唤铁傀儡
			}

			LeadStorageBlock: {
				DisplayName: 铅块
