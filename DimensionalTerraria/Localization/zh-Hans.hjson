			SheepSpawnEgg: {
				DisplayName: 羊生成蛋
				Tooltip:
					'''
					在地面生成一只羊
					三维模式下对准地面按右键
					'''
			}

			SlimeSpawnEgg: {
				DisplayName: 史莱姆蛋
				Tooltip:
					'''
					在地面生成一只蓝史莱姆
					三维模式下对准地面按右键
					'''
			}

			HigherDimensionalProjection: {
				DisplayName: 高维投影剑
				Tooltip: 三维模式下基础伤害提升至999
			}

			DebugBlaster: {
				DisplayName: 调试远程枪
				Tooltip: 不消耗弹药
			}
		}

		NPCs: {
			DebugTargetDummy.DisplayName: 调试假人
			MinecraftSheep.DisplayName: 羊
			MinecraftIronGolem.DisplayName: 铁傀儡
			MinecraftVillager.DisplayName: 村民
		}

		Character.NewSteve: 新建 Steve 角色
		Recipes.AnyTerrariaWood: 任意泰拉瑞亚木材

		Catalog: {
			InGameOnly: 请先进入单人世界
			Hint: 点击图标领取1个，Shift＋点击领取最多64个
			Ready: 单人世界内可领取物品
			Granted: 已领取 {0} ×{1}
			Full: 背包已满，无法领取
			Unavailable: 该物品当前不可领取
			SearchHint: 搜索：中文名／英文内部名／ID
			Clear: 清空
			Previous: 上一页
			Next: 下一页
			Page: 共{0}件 · {1}／{2}页
			NoResults: 未找到匹配物品
		}


		GolemSummoning: {
			Summoned: 铁块与南瓜化为了铁傀儡！
			NoSpace: 召唤失败：铁傀儡需要约3格宽、5格高的干燥空间，请清理南瓜上方和T型两侧；结构已保留，清理后重新放置顶部南瓜。
			Protected: 召唤失败：结构中有受保护、不可移除的方块；结构已保留。
			NoNpcSlot: 召唤失败：世界没有空闲生物槽位；结构已保留，稍后重新放置顶部南瓜。
		}

		Messages: {
			Disabled: 维度切换已在模组配置中禁用。
			CloseMenus: 请关闭设置或其他菜单后再切换维度。
			SinglePlayerOnly: 当前版本只支持单人模式的维度切换。
			CannotEnter: 请在无液体、身体不被遮挡的位置进入三维；先解除坐骑、抓钩等状态。
			ReturnOutOfWorld: 返回位置超出可游戏的世界边界。
			ReturnUnexplored: 此位置尚未在二维中探索，不能返回。请移动到已探索区域，或按返回出发位置的快捷键恢复。
			ReturnObstructed: 返回位置放不下完整角色，请将落点框移到空旷处。
			ReturnLiquid: 此原型暂不允许返回有液体的位置。
			RecoveryBlocked: 出发点及附近已探索区域暂时没有安全落点；请移动到其他空旷、干燥的已探索位置，按切换维度键返回。
			RenderFailed: 三维绘制失败，已恢复到出发点附近的安全位置；详细信息已写入 client.log。
		}

		FirstPerson: {
			EggTarget: 右键使用羊蛋，在地面生成羊
			SlimeEggTarget: 右键使用史莱姆蛋，在地面生成蓝史莱姆
			VillagerEggTarget: 右键使用村民蛋，在地面生成村民
			PlaceTarget: 按住右键放置 · 最远6格
			PlaceBlocked: 无法放置 · 靠近6格内已探索、无遮挡且有支撑的空位
			BoatTarget: 右键在地面或液面放置橡木船
			GolemTarget: 右键使用预制铁傀儡，在地面生成铁傀儡
			EggNoSpace: 请选择上方有足够空间的地面
			InventoryFull: 请先放下鼠标上的物品，背包已满
			MineTarget: 按住左键挖掘
			ShotTarget: 按住左键射击；破坏方块还需开启三维挖掘
			ShotBlockHit: 射击命中地形
			ShotBlockBroken: 射击破坏方块
			NeedTool: 请在快捷栏选择可挖掘或采集此目标的工具
			TargetUnexplored: 无法操作尚未探索的区域
			NoAmmo: 缺少此武器所需的弹药
			NoMana: 魔力不足，等待恢复后再攻击
			CannotAttack: 当前状态无法使用武器
			UnsupportedWeapon: 此武器尚未适配三维攻击
			ReturnReady: "[{0}] 返回二维"
			ReturnBlocked: 此处无法返回二维 · 移动到空旷、干燥的位置
			ReturnUnexplored: 探索迷雾：此处尚未探索，无法返回二维
			Inventory: 背包
			InventoryHint: E／Esc关闭 · 左键移动或堆叠 · 右键拆分 · 数字键选快捷栏
			Pause: 游戏菜单
			Resume: 继续三维飞行
			ReturnHere: 在此处返回二维
			ReturnStart: 返回出发位置
		}

		Hud: {
			Title: 三维飞行  |  原世界运行中
			ReturnReady: 绿色：此处容得下角色，可以返回二维。
			ReturnBlocked: 红色：角色被遮挡或接触液体，请寻找其他落点。
		}
	}
}
