				Tooltip: ""
			}

			SheepSpawnEgg: {
				DisplayName: Sheep Spawn Egg
				Tooltip:
					'''
					Spawns a sheep on the ground
					Right-click aimed ground in 3D
					'''
			}

			SlimeSpawnEgg: {
				DisplayName: Slime Spawn Egg
				Tooltip:
					'''
					Spawns a blue slime on the ground
					Right-click aimed ground in 3D
					'''
			}

			HigherDimensionalProjection: {
				DisplayName: High-Dimensional Projection Sword
				Tooltip: Base damage increases to 999 in 3D
			}

			DebugBlaster: {
				DisplayName: Debug Blaster
				Tooltip: Does not consume ammunition
			}
		}

		NPCs: {
			DebugTargetDummy.DisplayName: Debug Target Dummy
			MinecraftSheep.DisplayName: Sheep
			MinecraftIronGolem.DisplayName: Iron Golem
			MinecraftVillager.DisplayName: Villager
		}

		Character.NewSteve: New Steve character
		Recipes.AnyTerrariaWood: Any Terraria wood

		Catalog: {
			InGameOnly: Enter a single-player world first
			Hint: Click an icon for 1 item; Shift-click for up to 64
			Ready: Items can be claimed in a single-player world
			Granted: Received {0} x{1}
			Full: Inventory is full; no items granted
			Unavailable: This item is currently unavailable
			SearchHint: Search: name / internal name / ID
			Clear: Clear
			Previous: Prev
			Next: Next
			Page: "{0} items · {1}/{2}"
			NoResults: No matching items
		}


		GolemSummoning: {
			Summoned: The iron blocks and pumpkin became an Iron Golem!
			NoSpace: "Cannot summon: needs about 3 tiles of width and 5 of dry height. Clear above the pumpkin and beside the T, then replace the top pumpkin. Materials preserved."
			Protected: "Cannot summon: a structure block is protected from removal. Materials preserved."
			NoNpcSlot: "Cannot summon: no free NPC slot. Materials preserved; replace the top pumpkin later."
		}

		Messages: {
			Disabled: Dimension switching is disabled in this mod's configuration.
			CloseMenus: Close settings and other menus before switching dimensions.
			SinglePlayerOnly: Dimension switching is currently available in single-player only.
			CannotEnter: Stand in open, dry space. Dismount and release hooks before entering 3D.
			ReturnOutOfWorld: The return position is outside the playable world.
			ReturnUnexplored: This position has not been explored in 2D. Move to explored space or use your departure-point key to recover.
			ReturnObstructed: Your full character must fit at the return position. Move the green outline into open space.
			ReturnLiquid: Returning into liquids is disabled in this prototype.
			RecoveryBlocked: No safe explored position is available near departure. Fly to another open, dry, explored position and use the dimension key to return.
			RenderFailed: 3D rendering failed. Recovered to a safe position near departure; details are in client.log.
		}

		FirstPerson: {
			EggTarget: Right-click to use a sheep egg on this ground
			SlimeEggTarget: Right-click to use a slime egg on this ground
			VillagerEggTarget: Right-click to use a villager egg on this ground
			PlaceTarget: Hold right mouse to place · 6-tile reach
			PlaceBlocked: Cannot place · Find explored, visible, supported space within 6 tiles
			BoatTarget: Right-click to place an Oak Boat on ground or liquid
			GolemTarget: Right-click to use the prefabricated golem on this ground
			EggNoSpace: Choose ground with enough space above it
			InventoryFull: Place the cursor item first; inventory is full
			MineTarget: Hold left mouse to mine
			ShotTarget: Hold left mouse to shoot; block damage requires 3D mining enabled
			ShotBlockHit: Shot hit terrain
			ShotBlockBroken: Shot broke a block
			NeedTool: Select a tool that can mine or harvest this target
			TargetUnexplored: Cannot interact with an unexplored area
			NoAmmo: No suitable ammunition
			NoMana: Not enough mana; wait for it to recover
			CannotAttack: Cannot use a weapon in the current state
			UnsupportedWeapon: This weapon is not yet adapted for 3D attacks
			ReturnReady: "[{0}] return to 2D"
			ReturnBlocked: Cannot return here. Move to open, dry space.
			ReturnUnexplored: Exploration fog: this position is unexplored. Cannot return to 2D here.
			Inventory: Inventory
			InventoryHint: E / Esc close · Left click move / stack · Right click split · Numbers select hotbar
			Pause: Game menu
			Resume: Resume 3D flight
			ReturnHere: Return to 2D here
			ReturnStart: Return to departure point
		}

		Hud: {
			Title: 3D FLIGHT  |  World simulation running
			ReturnReady: GREEN: your character fits here; you can return to 2D.
			ReturnBlocked: RED: blocked or wet; move to an open return position.
		}
	}
}
