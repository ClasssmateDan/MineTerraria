Mods: {
	DimensionalTerraria: {
		Configs: {
			DimensionConfig: {
				DisplayName: MineTerraria Settings

				EnableExplorationFog: {
					Label: Enable 3D exploration fog
					Tooltip: Only shows explored terrain and prevents returning to unexplored positions.
				}

				ShowCreatures: {
					Label: Show creature sprites in 3D
					Tooltip: Shows creatures in 3D.
				}

				Enable3DMining: {
					Label: Enable 3D mining
					Tooltip: Allows mining and harvesting in 3D.
				}

				Enable3DCombat: {
					Label: Enable 3D weapon attacks
					Tooltip: Allows weapon attacks in 3D.
				}

				Enable3DPlacement: {
					Label: Enable 3D placement
					Tooltip: Allows placing blocks and furniture in 3D.
				}

				Enable3DPickup: {
					Label: Enable 3D pickup
					Tooltip: Automatically picks up nearby drops in 3D.
				}

				PickupRadius: {
					Label: 3D pickup radius
					Tooltip: Automatic pickup distance in tiles. Defaults to 6, adjustable from 2 to 12. Uses your flying body's actual distance, including depth away from the map.
				}

				EntryDistance: {
					Label: 3D entry distance
					Tooltip: Distance from the 2D world on entry, in tiles. Defaults to 32 tiles.
				}

				EnemyNoticeRange: {
					Label: Enemy rediscovery distance
					Tooltip: Distance at which enemies notice the player, in tiles.
				}

				EnemyLoseRange: {
					Label: Enemy disengagement distance
					Tooltip: Enemies lose their target beyond this distance, in tiles.
				}

				MouseSensitivity: {
					Label: Mouse sensitivity
					Tooltip: Drag the slider to adjust 3D camera speed in degrees per pixel. Defaults to 0.06; ranges from 0.01 to 0.30. Lower values turn more slowly. Saved custom values are preserved.
				}

				FieldOfView: {
					Label: First-person field of view
					Tooltip: Vertical camera field of view in degrees.
				}

				RenderDistance: {
					Label: 3D render distance
					Tooltip: Radius in 24-tile chunks. Larger values use more memory.
				}

				FlightSpeed: {
					Label: Flight speed
					Tooltip: Base flight speed. Hold Ctrl to boost.
				}

				SmoothEdges: {
					Label: Edge antialiasing
					Tooltip: Use 4x MSAA for geometry edges while keeping the original pixel textures.
				}

				ShowLandingOutline: {
					Label: Show the return outline
					Tooltip: Draw the green or red character projection on the world plane.
				}

				EnableSwitching: {
					Label: Enable dimension switching
					Tooltip: Allow entering 3D flight in single-player.
				}

			}


			ItemCatalogConfig: {
				DisplayName: Item catalog

				Items: {
					Label: Items from this mod
					Tooltip: ""
				}
			}

			VanillaItemCatalogConfig: {
				DisplayName: Vanilla Item Catalog

				Items: {
					Label: All vanilla items
					Tooltip: Search by localized name, internal English name or item ID, then click an icon to receive it. 30 items per page; grants require a single-player world.
				}
			}
		}

		Keybinds: {
			OpenBackpack.DisplayName: Open 3D backpack
			ToggleDimension.DisplayName: Switch 2D / 3D
			ReturnToAnchor.DisplayName: Return to departure point
		}

		Items: {
			NetheriteIngot: {
				DisplayName: Netherite Ingot
				Tooltip: Used to craft Higher Dimensional Projection equipment
			}
			Firework: {
				DisplayName: Firework
				Tooltip:
					'''
					Propels you toward the mouse
					Hold right mouse in 3D to boost toward the crosshair
					'''
			}
			MinecraftChest: {
				DisplayName: Minecraft Chest
				Tooltip:
					'''
					Right-click to open
					Empty the chest before breaking it
					'''
			}
			VillagerSpawnEgg: {
				DisplayName: Villager Spawn Egg
				Tooltip:
					'''
					Spawns a villager on the ground
					Right-click aimed ground in 3D
					'''
			}
			Bedrock: {
				DisplayName: Bedrock
				Tooltip: Can only be broken in 3D with the Higher Dimensional Projection Pickaxe
			}
			HigherDimensionalPickaxe: {
				DisplayName: Higher Dimensional Projection Pickaxe
				Tooltip: Can break bedrock in 3D
			}
			HigherDimensionalHelmet: {
				DisplayName: Higher Dimensional Projection Helmet
				Tooltip: Complete the set for passive protection
				SetBonus: Immunity to lava, fire blocks, falling, knockback and common debuffs
			}
			HigherDimensionalChestplate: {
				DisplayName: Higher Dimensional Projection Chestplate
				Tooltip: Complete the set for passive protection
			}
			HigherDimensionalLeggings: {
				DisplayName: Higher Dimensional Projection Leggings
				Tooltip: Complete the set for passive protection
			}
			Hopper: {
				DisplayName: Hopper
				Tooltip:
					'''
					Collects drops in the tile directly above into the chest below
					Does not extract from a chest above
					'''
			}
			Redstone: {
				DisplayName: Redstone
				Tooltip: Redstone crafting material
			}
			RedstoneBlock: {
				DisplayName: Redstone Block
				Tooltip: Powers adjacent tiles in all four directions
			}
			RedstonePulser: {
				DisplayName: Redstone Pulser
				Tooltip:
					'''
					Pulses in all four directions, switching every half second
					Right-click to invert the signal
					'''
			}
			Piston: {
				DisplayName: Piston
				Tooltip:
					'''
					Extends when powered, pushing up to 12 tiles
					Right-click while retracted to rotate
					'''
			}
			StickyPiston: {
				DisplayName: Sticky Piston
				Tooltip:
					'''
					Pulls one tile back when retracting
					Right-click while retracted to rotate
					'''
			}
			OakBoat: {
				DisplayName: Oak Boat
				Tooltip:
					'''
					Use on ground or liquid; right-click in 3D
					Traps passing creatures; breaks when attacked
					Releases a boss before the passenger takes damage
					'''
			}
			OakPlanks: {
				DisplayName: Oak Planks
				Tooltip: Building material
			}
			MinecraftCraftingTable: {
				DisplayName: Minecraft Crafting Table
				Tooltip: Stand nearby to craft Minecraft items
			}
			PrefabIronGolem: {
				DisplayName: Prefabricated Iron Golem
				Tooltip:
					'''
					Spawns an iron golem on the ground
					Right-click aimed ground in 3D
					'''
			}
			CopperStorageBlock: {
				DisplayName: Copper Block
				Tooltip: ""
			}

			TinStorageBlock: {
				DisplayName: Tin Block
				Tooltip: ""
			}

			IronStorageBlock: {
				DisplayName: Iron Block
				Tooltip: Build a T from four blocks and place a pumpkin on top to summon an iron golem
			}

			LeadStorageBlock: {
				DisplayName: Lead Block
				Tooltip: ""
			}

			SilverStorageBlock: {
				DisplayName: Silver Block
				Tooltip: ""
			}

			TungstenStorageBlock: {
				DisplayName: Tungsten Block
				Tooltip: ""
			}

			GoldStorageBlock: {
